# =====================================================
# PostgreSQL
# =====================================================

POSTGRES_USER=industrial
POSTGRES_PASSWORD=change-me
POSTGRES_DB=industrial
POSTGRES_PORT=5432

# =====================================================
# Backend API
# =====================================================

HOST=0.0.0.0
BACKEND_PORT=3000
NOMINAL_CAPACITY_PER_HOUR=400

# Alertas: faixa aceitável do nível de envase e tempo máximo de linha parada (ms).
ALERT_FILL_PERCENT_MIN=0
ALERT_FILL_PERCENT_MAX=100
ALERT_STOPPED_MS=60000

# Produção por hora/turno: fuso da planta e janela dos turnos.
PLANT_TIMEZONE=America/Sao_Paulo
SHIFT_START_HOUR=6
SHIFT_HOURS=8

# Dentro do Docker Compose use o host "postgres"; localmente use "localhost".
DATABASE_URL=postgresql://industrial:change-me@postgres:5432/industrial

# =====================================================
# Gateway Industrial
# =====================================================

# ads | opcua | modbus | simulator
INDUSTRIAL_PROTOCOL=ads
GATEWAY_MACHINE_ID=Linha-01
GATEWAY_POLL_MS=1000

# ADS (TwinCAT)
ADS_TARGET_AMS_NET_ID=39.90.64.65.1.1
ADS_TARGET_PORT=851
ADS_TIMEOUT_MS=5000

# OPC-UA
OPCUA_ENDPOINT_URL=opc.tcp://localhost:4840
OPCUA_SECURITY_MODE=None
OPCUA_SECURITY_POLICY=None

# Modbus TCP
MODBUS_HOST=127.0.0.1
MODBUS_PORT=502
MODBUS_UNIT_ID=1

# Fora do Docker, use BACKEND_URL=http://localhost:3000.

# =====================================================
# Simulator
# =====================================================

MACHINE_ID=Linha-01

SIMULATOR_INTERVAL_MS=2000

BACKEND_URL=http://backend:3000

# =====================================================
# Dashboard
# =====================================================

API_BASE_URL=http://backend:3000